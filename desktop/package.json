{
  "name": "schadensfaelle",
  "productName": "Schadensfälle",
  "version": "4.21.0",
  "description": "Schadensfälle bei Transportaufträgen nachhaken und bearbeiten",
  "main": "main.js",
  "private": true,
  "author": "Ayse Transport UG",
  "license": "UNLICENSED",
  "scripts": {
    "vorbereiten": "node scripts/vorbereiten.js",
    "start": "npm run vorbereiten && electron .",
    "test": "npm run vorbereiten && node --test --test-timeout=180000 --test-concurrency=1 test/mail.test.js test/webupdate.test.js test/app.test.js",
    "dist:win": "npm run vorbereiten && electron-builder --win nsis --publish never",
    "dist:win:linux": "npm run vorbereiten && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@tesseract.js-data/deu": "1.0.0",
    "electron-updater": "6.8.12",
    "imapflow": "2.9.1",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.1",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "de.aysetransport.schaden",
    "productName": "Schadensfälle",
    "files": [
      "main.js",
      "preload.js",
      "mail.js",
      "webupdate.js",
      "scan.js",
      "app/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/icon-rund.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Schadensfälle",
      "artifactName": "Schadensfaelle-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/aysetransport/schaden/releases/download/windows-app/"
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/deu/4.0.0/**"
    ]
  }
}
